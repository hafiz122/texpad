\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texpadbellcurve}[2026/11/08 Bell curve for Texpad]
\RequirePackage{expl3}
\RequirePackage{color}

\ExplSyntaxOn
\cs_new:Npn \texpadbellcurve_number:n #1
  { \fp_eval:n { round((#1), 8) } }

\seq_new:N \l__texpadbellcurve_bounds_seq
\fp_new:N \l__texpadbellcurve_lower_fp
\fp_new:N \l__texpadbellcurve_upper_fp
\fp_new:N \l__texpadbellcurve_lower_z_fp
\fp_new:N \l__texpadbellcurve_upper_z_fp
\fp_new:N \l__texpadbellcurve_z_fp
\fp_new:N \l__texpadbellcurve_t_fp
\fp_new:N \l__texpadbellcurve_tail_fp
\fp_new:N \l__texpadbellcurve_lower_cdf_fp
\fp_new:N \l__texpadbellcurve_upper_cdf_fp
\fp_new:N \l__texpadbellcurve_segment_left_fp
\fp_new:N \l__texpadbellcurve_segment_right_fp
\fp_new:N \l__texpadbellcurve_segment_mid_fp
\int_new:N \l__texpadbellcurve_area_int

\cs_new_protected:Npn \texpadbellcurve_cdf:nN #1#2
  {
    \fp_set:Nn \l__texpadbellcurve_z_fp {#1}
    \fp_compare:nTF { \l__texpadbellcurve_z_fp >= 8 }
      { \fp_set:Nn #2 {1} }
      {
        \fp_compare:nTF { \l__texpadbellcurve_z_fp <= -8 }
          { \fp_set:Nn #2 {0} }
          {
            \fp_set:Nn \l__texpadbellcurve_t_fp
              { 1 / (1 + 0.2316419 * abs(\l__texpadbellcurve_z_fp)) }
            \fp_set:Nn \l__texpadbellcurve_tail_fp
              {
                exp(-\l__texpadbellcurve_z_fp^2 / 2) / 2.506628274631
                * (0.319381530 * \l__texpadbellcurve_t_fp
                - 0.356563782 * \l__texpadbellcurve_t_fp^2
                + 1.781477937 * \l__texpadbellcurve_t_fp^3
                - 1.821255978 * \l__texpadbellcurve_t_fp^4
                + 1.330274429 * \l__texpadbellcurve_t_fp^5)
              }
            \fp_compare:nTF { \l__texpadbellcurve_z_fp >= 0 }
              { \fp_set:Nn #2 { 1 - \l__texpadbellcurve_tail_fp } }
              { \fp_set_eq:NN #2 \l__texpadbellcurve_tail_fp }
          }
      }
  }

\cs_new_protected:Npn \texpadbellcurve_edge:N #1
  {
    \fp_compare:nT { #1 >= -4 }
      {
        \fp_compare:nT { #1 <= 4 }
          {
            \put(\fp_eval:n { 12 + (#1 + 4) * 37 },43)
              {\line(0,1){\fp_eval:n { 93 * exp(-#1^2 / 2) }}}
          }
      }
  }

\cs_new_protected:Npn \texpadbellcurve_shade:
  {
    \fp_compare:nT { \l__texpadbellcurve_lower_z_fp < \l__texpadbellcurve_upper_z_fp }
      {
        \color[rgb]{0.67,0.79,0.89}
        \int_step_inline:nnnn {0}{1}{147}
          {
            \fp_set:Nn \l__texpadbellcurve_z_fp { -4 + ##1 * 2 / 37 }
            \fp_set:Nn \l__texpadbellcurve_segment_left_fp
              { max(\l__texpadbellcurve_z_fp, \l__texpadbellcurve_lower_z_fp) }
            \fp_set:Nn \l__texpadbellcurve_segment_right_fp
              { min(\l__texpadbellcurve_z_fp + 2 / 37, \l__texpadbellcurve_upper_z_fp) }
            \fp_compare:nT
              { \l__texpadbellcurve_segment_right_fp > \l__texpadbellcurve_segment_left_fp }
              {
                \fp_set:Nn \l__texpadbellcurve_segment_mid_fp
                  { (\l__texpadbellcurve_segment_left_fp + \l__texpadbellcurve_segment_right_fp) / 2 }
                \linethickness{\fp_eval:n
                  { 37 * (\l__texpadbellcurve_segment_right_fp - \l__texpadbellcurve_segment_left_fp) }pt}
                \put(\fp_eval:n { 12 + 37 * (\l__texpadbellcurve_segment_mid_fp + 4) },43)
                  {\line(0,1){\fp_eval:n { 93 * exp(-\l__texpadbellcurve_segment_mid_fp^2 / 2) }}}
              }
          }
        \color[rgb]{0.20,0.37,0.55}
        \linethickness{0.7pt}
        \fp_compare:nT
          { \l__texpadbellcurve_upper_z_fp - \l__texpadbellcurve_lower_z_fp >= 2 / 37 }
          {
            \texpadbellcurve_edge:N \l__texpadbellcurve_lower_z_fp
            \texpadbellcurve_edge:N \l__texpadbellcurve_upper_z_fp
          }
        \color{black}
      }
  }

\NewDocumentCommand{\bellcurve}{mmo}
