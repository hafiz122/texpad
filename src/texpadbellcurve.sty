    \begin{center}
    \begingroup
    \fp_compare:nF { #2 > 0 }
      { \PackageError{texpadbellcurve}{Standard~deviation~must~be~positive}{} }
    \IfNoValueF{#3}
      {
        \seq_set_split:Nnn \l__texpadbellcurve_bounds_seq {,} {#3}
        \int_compare:nNnF {\seq_count:N \l__texpadbellcurve_bounds_seq} = {2}
          { \PackageError{texpadbellcurve}{Use~two~bounds:~[lower,upper]}{} }
        \fp_set:Nn \l__texpadbellcurve_lower_fp
          { \seq_item:Nn \l__texpadbellcurve_bounds_seq {1} }
        \fp_set:Nn \l__texpadbellcurve_upper_fp
          { \seq_item:Nn \l__texpadbellcurve_bounds_seq {2} }
        \fp_compare:nF { \l__texpadbellcurve_lower_fp <= \l__texpadbellcurve_upper_fp }
          { \PackageError{texpadbellcurve}{Lower~bound~exceeds~upper~bound}{} }
        \fp_set:Nn \l__texpadbellcurve_lower_z_fp
          { (\l__texpadbellcurve_lower_fp - (#1)) / (#2) }
        \fp_set:Nn \l__texpadbellcurve_upper_z_fp
          { (\l__texpadbellcurve_upper_fp - (#1)) / (#2) }
        \texpadbellcurve_cdf:nN {\l__texpadbellcurve_lower_z_fp} \l__texpadbellcurve_lower_cdf_fp
        \texpadbellcurve_cdf:nN {\l__texpadbellcurve_upper_z_fp} \l__texpadbellcurve_upper_cdf_fp
        \int_set:Nn \l__texpadbellcurve_area_int
          { \fp_eval:n { round(1000 * (\l__texpadbellcurve_upper_cdf_fp - \l__texpadbellcurve_lower_cdf_fp), 0) } }
